# ==============================================================================
# GoF Design Patterns Masterclass — Backend Environment Variables
# ==============================================================================
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
LOG_LEVEL=info

# Database (PostgreSQL + Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/design_patterns
DB_POOL_MAX=10

# Authentication (Better Auth)
BETTER_AUTH_SECRET=your-random-32-character-secret-key-goes-here
BETTER_AUTH_URL=http://localhost:3000
INITIAL_ADMIN_IDS=

# OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Built-in Pro AI Architect (Managed Cloud)
GEMINI_API_KEY=
AI_MODEL=

# Object Storage (Cloudflare R2 / Backblaze B2)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=gof-notes-media
S3_REGION=auto
S3_PUBLIC_CDN_URL=https://media.yourdomain.com
