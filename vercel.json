{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "entrypoint": "src/index.ts",
      "bindings": [
        {
          "type": "service",
          "service": "pattern-masterclass",
          "format": "url",
          "env": "FRONTEND_URL"
        }
      ]
    },
    "pattern-masterclass": {
      "root": "artifacts/pattern-masterclass",
      "framework": "vite",
      "outputDirectory": "dist/public",
      "bindings": [
        {
          "type": "service",
          "service": "api-server",
          "format": "url",
          "env": "API_SERVER_URL"
        }
      ]
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "pattern-masterclass"
      }
    }
  ]
}
