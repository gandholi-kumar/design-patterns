# ==============================================================================
# GoF Design Patterns Masterclass — Environment Variables Template
# ==============================================================================
# Copy this file to `.env` in the root or inside `artifacts/api-server/.env`
# Note: For frontend-only local development, NO environment variables are required!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Server & Networking
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS:
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Database Foundation (PostgreSQL + Drizzle ORM)
# ------------------------------------------------------------------------------
# Required for full-stack cloud notes, user sessions, and learning progress:
# Local Postgres example: postgresql://postgres:postgres@localhost:5432/design_patterns
# Neon / Supabase example: postgresql://user:pass@ep-cool-db.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/design_patterns
DB_POOL_MAX=10

# ------------------------------------------------------------------------------
# 3. Authentication & RBAC (Better Auth)
# ------------------------------------------------------------------------------
# Secret key for encrypting sessions and signing cookies (generate with `openssl rand -base64 32`)
BETTER_AUTH_SECRET=your-random-32-character-secret-key-goes-here
# Canonical URL of the auth server:
BETTER_AUTH_URL=http://localhost:3000

# Initial admin users (comma-separated list of user IDs to grant admin role on startup)
INITIAL_ADMIN_IDS=

# (Optional) Social OAuth Providers:
# Leave blank to use Email + Password authentication only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 4. Built-in Pro AI Architect (Managed Cloud Engine)
# ------------------------------------------------------------------------------
# Upstream Google Gemini API key used by the backend for Pro member consultations:
# If left blank, learners can still use BYOK mode directly in the browser!
GEMINI_API_KEY=
# Optional model override (defaults to auto-discovering newest active Flash model):
AI_MODEL=

# ------------------------------------------------------------------------------
# 5. Object Storage (Cloudflare R2 or Backblaze B2 S3 SDK)
# ------------------------------------------------------------------------------
# Optional: Only needed for rich media notes & diagram asset uploads
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=gof-notes-media
S3_REGION=auto
S3_PUBLIC_CDN_URL=https://media.yourdomain.com
